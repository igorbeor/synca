# Postgres (host port 5434; default 5432 was taken by other local Postgres instances)
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5434/whiteboard
# Redis (host port 6380; default 6379 was taken by another local Redis)
REDIS_URL=redis://localhost:6380
# Service ports — each NestJS app reads PORT (defaults: api 3000, realtime 3001)
# PORT=3000
# JWT secret for board access tokens (used from Sprint 1)
JWT_SECRET=dev-secret-change-me
